# .env.example — copy this to .env and fill in your values
# These are the only variables needed in .env (frontend-only, VITE_ prefixed)
# All sensitive API keys are stored as backend secrets, NOT here.

VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_key
VITE_SUPABASE_PROJECT_ID=your_supabase_project_id

# ⚠️ IMPORTANT: The following keys must be set as backend secrets (not in .env):
# - OPENROUTER_API_KEY     (OpenRouter free tier for AI job search & email composition)
# - GMAIL_APP_PASSWORD     (Gmail SMTP for sending application emails)
# - HUNTER_API_KEY         (Hunter.io for verified email discovery)
# - SCRAPINGBEE_API_KEY    (ScrapingBee for JS-rendered page scraping)
#
# To set backend secrets, go to Lovable Cloud settings.
